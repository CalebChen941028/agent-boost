{
  "name": "agent-boost",
  "version": "0.6.4",
  "description": "Multi-agent deep reasoning workflow engine for complex problems",
  "type": "module",
  "main": "shared/verify-gate.js",
  "types": "shared/verify-gate.d.ts",
  "bin": {
    "agent-boost": "./bin/agent-boost.mjs",
    "boost": "./bin/agent-boost.mjs"
  },
  "files": [
    "bin",
    "shared",
    "adapters",
    "roles",
    "protocol",
    "skills",
    "scripts",
    "models.example.json",
    "install.sh",
    "uninstall.sh",
    "VERSION",
    "README.md",
    "README.zh-CN.md",
    "BENCHMARKS.md",
    "BENCHMARKS.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs",
    "benchmark": "node scripts/run-live-benchmarks.mjs",
    "benchmark:live": "node scripts/run-live-benchmarks.mjs",
    "benchmark:selftest": "node scripts/run-live-benchmarks.mjs --offline-selftest",
    "benchmark:report": "node scripts/generate-benchmark-report.mjs",
    "benchmark:compare": "node scripts/generate-benchmark-report.mjs --compare"
  },
  "keywords": [
    "multi-agent",
    "deep-reasoning",
    "orchestration",
    "workflow",
    "verification",
    "harness2"
  ],
  "author": "Chen Liangliang",
  "license": "MIT"
}
