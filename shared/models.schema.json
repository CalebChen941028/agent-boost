{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelConfiguration",
  "type": "object",
  "properties": {
    "default_light_model": {
      "type": "string",
      "description": "Default lightweight model identifier"
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "vendor": { "type": "string" },
          "tier": { "type": "string", "enum": ["heavy", "light"] }
        },
        "required": ["id"]
      }
    }
  },
  "required": ["default_light_model", "models"]
}
